---
import "../global/admin.css";
import {
  LayoutDashboard,
  UtensilsCrossed,
  MessageSquareQuote,
  Images,
  Settings,
  ExternalLink,
  LogOut,
  Menu
} from "@lucide/astro";
const {
  title = "Dashboard",
  subtitle = "Kelola konten website catering Anda",
  active = "overview"
} = Astro.props;

const navItems = [
  {
    key: "overview",
    href: "/admin",
    label: "Ringkasan",
    icon: LayoutDashboard
  },
  {
    key: "menus",
    href: "/admin/menus",
    label: "Menu",
    icon: UtensilsCrossed
  },
  {
    key: "testimonials",
    href: "/admin/testimonials",
    label: "Testimoni",
    icon: MessageSquareQuote
  },
  {
    key: "gallery",
    href: "/admin/gallery",
    label: "Galeri",
    icon: Images
  },
  {
    key: "settings",
    href: "/admin/settings",
    label: "Pengaturan",
    icon: Settings
  }
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    <title>{title} — Admin Ar Rahman Catering</title>
  </head>
  <body>
    <div class="admin-shell">
      <aside class="admin-sidebar" data-sidebar>
        <a href="/admin" class="admin-brand">
          <span class="admin-brand-logo">AR</span>
          <span class="admin-brand-text">
            <strong>AR RAHMAN</strong>
            <span>Admin Panel</span>
          </span>
        </a>

        <nav class="admin-nav">
          <span class="admin-nav-label">Kelola Website</span>
          {
            navItems.map((item) => {
              const Icon = item.icon;
              return (
                <a
                  href={item.href}
                  class:list={{ active: active === item.key }}
                >
                  <Icon size={18} />
                  <span>{item.label}</span>
                </a>
              );
            })
          }
        </nav>

        <div class="admin-sidebar-footer">
          <a href="/" target="_blank" rel="noopener noreferrer">
            <ExternalLink size={16} />
            <span>Lihat Website</span>
          </a>
          <button type="button" data-logout>
            <LogOut size={16} />
            <span>Keluar</span>
          </button>
        </div>
      </aside>

      <div class="admin-sidebar-overlay" data-sidebar-overlay></div>

      <div class="admin-main">
        <header class="admin-topbar">
          <button
            class="admin-menu-toggle"
            type="button"
            aria-label="Buka menu"
            data-menu-toggle
          >
            <Menu size={18} />
          </button>

          <div class="admin-topbar-title">
            <h1>{title}</h1>
            <p>{subtitle}</p>
          </div>

          <div class="admin-topbar-user">
            <span data-admin-name>Admin</span>
            <span class="admin-avatar" data-admin-initial>A</span>
          </div>
        </header>

        <main class="admin-content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      import { requireAdmin, logoutAdmin } from "../lib/admin-api.js";

      (async () => {
        const admin = await requireAdmin();

        if (admin) {
          const name = admin.username || "Admin";

          document.querySelectorAll("[data-admin-name]").forEach((element) => {
            element.textContent = name;
          });

          document.querySelectorAll("[data-admin-initial]").forEach((element) => {
            element.textContent = name.charAt(0).toUpperCase();
          });
        }
      })();

      const sidebar = document.querySelector("[data-sidebar]");
      const overlay = document.querySelector("[data-sidebar-overlay]");
      const toggle = document.querySelector("[data-menu-toggle]");

      function closeSidebar() {
        sidebar?.classList.remove("open");
        overlay?.classList.remove("visible");
      }

      toggle?.addEventListener("click", () => {
        sidebar?.classList.toggle("open");
        overlay?.classList.toggle("visible");
      });

      overlay?.addEventListener("click", closeSidebar);

      document.querySelectorAll(".admin-nav a").forEach((link) => {
        link.addEventListener("click", closeSidebar);
      });

      document.querySelector("[data-logout]")?.addEventListener("click", () => {
        logoutAdmin();
      });
    </script>
  </body>
</html>
