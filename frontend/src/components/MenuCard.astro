---
import { formatRupiah } from "../data/menu.js";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";

const { menu } = Astro.props;

const message = `Halo, Saya ingin memesan ${menu.name}`;
const whatsapp = `https://wa.me/6282142128202?text=${encodeURIComponent(message)}`;
---

<article class="card menu-card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
  <img
    src={menu.image || "/images/nasi-box.jpg"}
    alt={menu.name}
    class="card-img-top"
    loading="lazy"
  />

  <div class="card-body d-flex flex-column p-4">
    <div class="d-flex flex-wrap gap-2 mb-2">
      <span class="badge bg-success-subtle text-success-emphasis">{menu.category}</span>
      {menu.popular && <span class="badge bg-warning-subtle text-warning-emphasis">Favorit</span>}
    </div>

    <h3 class="h5 fw-bold mb-2">{menu.name}</h3>
    <p class="small text-secondary">{menu.description}</p>

    <div class="mt-auto d-flex align-items-center justify-content-between gap-3 pt-3 border-top">
      <strong class="fs-5 text-success">{formatRupiah(menu.price)}</strong>

      <a
        href={whatsapp}
        class="btn btn-success btn-sm rounded-pill px-3"
        target="_blank"
        rel="noopener noreferrer"
        data-whatsapp-link
        data-wa-message={message}
      >
        <WhatsAppIcon size={16} /> Pesan
      </a>
    </div>
  </div>
</article>
